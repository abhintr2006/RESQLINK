# RESQLINK Backend Environment Configuration
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./resqlink.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://resqlink:password@localhost:5432/resqlink

# ── JWT ───────────────────────────────────────────────────────────────────────
# CHANGE THIS in production — use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=resqlink-development-secret-CHANGE-ME-in-production
JWT_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_SOS=5/minute
RATE_LIMIT_LOGIN=10/minute

# ── Twilio SMS (optional — leave empty to use simulated mode) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Twilio Voice Stage 3 (optional — leave empty to use simulated calls) ─────
TWILIO_VOICE_FROM_NUMBER=
TWILIO_VOICE_STATUS_CALLBACK_URL=
TELEPHONY_CALLBACK_SECRET=replace-with-a-random-callback-secret

# ── TTS Stage 3 (optional — simulated mode is used by default) ────────────────
TTS_PROVIDER=simulated
TTS_API_KEY=
TTS_API_URL=
TTS_VOICE=alloy
PUBLIC_MEDIA_BASE_URL=

# ── Voice call retry policy ───────────────────────────────────────────────────
VOICE_CALL_MAX_ATTEMPTS=3
VOICE_CALL_RETRY_DELAY_SECONDS=10

# ── Fixed SOS recipient ───────────────────────────────────────────────────────
SOS_RECIPIENT_NUMBER=+917013753816
SOS_VOICE_MESSAGE=The patient is having emergency. Please provide emergency assistance.
