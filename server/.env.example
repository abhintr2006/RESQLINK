# RESQLINK Backend Environment Configuration
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: Supabase PostgreSQL (Cloud Storage)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Option 2: Local development (SQLite — zero-setup default)
DATABASE_URL=sqlite+aiosqlite:///./resqlink.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# CHANGE THIS in production — use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=resqlink-development-secret-CHANGE-ME-in-production
JWT_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_SOS=5/minute
RATE_LIMIT_LOGIN=10/minute

# ── Twilio SMS (optional — leave empty to use simulated mode) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
